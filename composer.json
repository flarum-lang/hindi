{
	"name": "flarum-lang/hindi",
	"description": "Hindi Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/hindi",
	"license": "MIT",
	"support": {
		"issues": "https://github.com/flarum-lang/hindi/issues",
		"forum": "https://discuss.flarum.org/d/33972",
		"source": "https://github.com/flarum-lang/hindi"
	},
	"require": {
		"flarum/core": "^1.0"
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.x-dev"
		},
		"flarum-extension": {
			"title": "Hindi",
			"category": "language",
			"icon": {
				"image": "icon.svg",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
			}
		},
		"flarum-locale": {
			"code": "hi",
			"title": "हिन्दी"
		}
	}
}
